# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# Supabase PostgreSQL connection string
# Supabase Dashboard -> Project Settings -> Database -> Connection string
# Use the "Session pooler" connection string when your network does not support IPv6.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
# Optional, set to true only when DATABASE_CA is also supplied.
DATABASE_SSL_STRICT=false
# DATABASE_CA=-----BEGIN CERTIFICATE-----...

# Use a long random value (32+ characters). Never share this.
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# Allow all origins during development. For web deployments, set your domain.
CORS_ORIGIN=*

# Used only by `npm run db:setup`.
# The admin is created only when no admin exists yet.
ADMIN_USERNAME=admin
ADMIN_NAME=Administrator
ADMIN_PASSWORD=Admin@123
# Set to true to reset the oldest admin's password on the next setup run.
# RESET_ADMIN_PASSWORD=true

# Required to open Admin -> Manage admins in the live app.
# Choose a unique, strong password and keep it private.
ADMIN_MASTER_PASSWORD=replace-with-a-private-main-admin-password
